{
  "name": "mockport-server",
  "version": "0.1.12",
  "private": true,
  "description": "A mock port server for testing HTTP requests.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:animal": "MOCKFILE=./data/animal.json node src/index.js",
    "test": "node --test --test-timeout=20000 \"test/unit/**/*.js\"",
    "test:coverage": "mkdir -p coverage && node --test --test-timeout=20000 --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=coverage/report.txt --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/unit/**/*.js\"",
    "docker:build": "docker build -t mitchallen/mockport-server .",
    "docker:run": "docker run -d -p 7777:1234 -v ${PWD}/test/data:/usr/src/app/data --name mockport-server mitchallen/mockport-server",
    "docker:start": "docker start mockport-server",
    "docker:stop": "docker stop mockport-server",
    "docker:rm": "docker rm mockport-server",
    "docker:stopped": "docker ps -f \"status=exited\""
  },
  "keywords": [
    "testing",
    "TDD",
    "mock",
    "automation",
    "sqa",
    "qa",
    "mocha",
    "chai",
    "nock",
    "ngrok",
    "axios",
    "sinon",
    "REST",
    "loopback"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/mockport-server.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
